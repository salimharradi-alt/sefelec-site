# ============================================================
#  SEFELEC — Protection du dossier d'administration
# ============================================================

# Pas de liste de fichiers si l'on ouvre /admin/ sans page.
Options -Indexes

# La racine du site impose « DirectoryIndex index.html », absent ici :
# sans cette ligne, ouvrir /admin/ renvoyait une erreur 403.
DirectoryIndex index.php

# ------------------------------------------------------------
#  Accès direct aux fichiers PHP
# ------------------------------------------------------------
# Tout est refusé, puis les pages réelles sont autorisées une à une.
#
# Une liste blanche plutôt qu'une liste noire : les fichiers de
# bibliothèque — schéma, données, champs, ossature — sont conçus pour
# être inclus, pas appelés. Appelés directement, ils s'exécuteraient
# sans leur contexte et pourraient révéler des chemins du serveur.
# Avec une liste noire, chaque nouveau fichier oublié restait exposé :
# c'est arrivé lors de l'ajout du moteur générique.
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "^(index|connexion|deconnexion|liste|editer|supprimer|reglages|installer|mot-de-passe-changer)\.php$">
  Require all granted
</FilesMatch>

# L'administration ne doit apparaître dans aucun moteur de recherche.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# ============================================================
#  SEFELEC — Configuration du tableau de bord EN LIGNE
# ============================================================
# À copier en « .env » UNIQUEMENT sur l'hébergement, jamais en local.
# Ne jamais publier ce fichier une fois rempli : il ouvre l'accès
# complet au contenu du site.
#
# Générez KEY et SECRET NEUFS pour la production — ne réutilisez pas
# ceux de votre machine :
#   node -e "console.log(require('crypto').randomUUID())"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

KEY=a-remplacer-par-un-uuid-neuf
SECRET=a-remplacer-par-une-chaine-aleatoire-neuve

DB_CLIENT=sqlite3
DB_FILENAME=./data.db

# ------------------------------------------------------------
#  IMPORTANT — ne définissez NI « PORT » NI « HOST » ici.
#
#  En local, .env impose PORT=8055. Sur l'hébergement, c'est
#  Passenger qui attribue le port : le figer empêcherait cPanel
#  de router les requêtes, et le tableau de bord répondrait 503.
#  Ce piège a été constaté au test, pas deviné.
# ------------------------------------------------------------

# Adresse publique réelle du tableau de bord. Doit correspondre
# exactement au sous-domaine créé dans cPanel, sinon la connexion
# boucle sans jamais aboutir.
PUBLIC_URL=https://admin.sefelec.ma

# Le site public et le tableau de bord sont sur deux sous-domaines
# distincts : le navigateur exige donc une autorisation explicite.
CORS_ENABLED=true
CORS_ORIGIN=https://www.sefelec.ma
CORS_CREDENTIALS=true

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Désactivé en ligne : les WebSockets consomment un processus
# permanent, ressource comptée sur un hébergement mutualisé.
WEBSOCKETS_ENABLED=false

# Journalisation réduite : « info » remplirait votre quota disque.
LOG_LEVEL=warn

# ------------------------------------------------------------
#  Sécurité — le tableau de bord devient accessible publiquement
# ------------------------------------------------------------
# Cookies transmis uniquement en HTTPS.
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=none
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=none

# Ralentit les tentatives de mot de passe par force brute.
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

# Ne renseignez PAS ADMIN_EMAIL / ADMIN_PASSWORD ici : le compte
# existe déjà dans data.db que vous transférez. Les inscrire
# laisserait un mot de passe en clair sur le serveur.

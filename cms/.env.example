# ============================================================
#  SEFELEC — Modèle de configuration du back-office
# ============================================================
# Copiez ce fichier en « .env » et remplacez les valeurs.
# Le vrai fichier .env n'est jamais publié sur GitHub.
#
# Pour générer KEY et SECRET :
#   node -e "console.log(require('crypto').randomUUID())"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

KEY=remplacez-par-un-uuid-aleatoire
SECRET=remplacez-par-une-chaine-aleatoire-de-64-caracteres

DB_CLIENT=sqlite3
DB_FILENAME=./data.db

# Écoute en local uniquement : le back-office n'est pas exposé sur le réseau.
HOST=127.0.0.1
PORT=8055
PUBLIC_URL=http://localhost:5500

# Compte administrateur créé au premier démarrage.
# Choisissez une adresse peu devinable : elle sert d'identifiant de connexion.
ADMIN_EMAIL=votre-email@exemple.com
ADMIN_PASSWORD=choisissez-un-mot-de-passe-solide

CORS_ENABLED=true
CORS_ORIGIN=true
CORS_CREDENTIALS=true

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

WEBSOCKETS_ENABLED=true
